# Denver Store Bot — exemplo de configuração.
# Copia este ficheiro para .env e preenche os valores.
#   cp .env.example .env

# --- Obrigatório ---
# Token do bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# ID da aplicação (Developer Portal > General Information > Application ID)
CLIENT_ID=

# --- Recomendado ---
# ID do teu servidor (ativa a limpeza de comandos / com scoped ao guild)
GUILD_ID=

# --- Opcional (têm valores por omissão no código) ---
# Caminho da base de dados SQLite (usa um volume persistente em produção)
# DATABASE_PATH=loja.db
# Moeda usada pelo seed (eur | brl | usd | gbp). Por omissão: eur
# SEED_CURRENCY=eur

# Canais e cargos (IDs do Discord)
# PEDIDOS_CHANNEL_ID=
# LOG_CHANNEL_ID=
# TICKETS_CATEGORIA_ID=
# TICKETS_CARGO_STAFF_ID=
# VERIFY_ROLE_ID=
# FUTURO_CLIENTE_ROLE_ID=

# Banners / textos
# LOJA_BANNER_URL=
# TICKETS_BANNER_URL=
# VERIFY_BANNER_URL=
# PAYMENT_INFO=
